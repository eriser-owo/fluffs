# .env.example 复制+改名 .env
# 优先级 env > config.toml

# ---- 连接（[connection]）----
FLUFFS_CONNECTION_MODE=reverse_ws
FLUFFS_HOST=127.0.0.1
FLUFFS_PORT=8080
FLUFFS_PATH=/onebot/v11/ws
FLUFFS_TOKEN=
FLUFFS_FORWARD_URL=ws://127.0.0.1:3001

# ---- Bot（[bot]）----
FLUFFS_SELF_ID=0
# 多个超级用户用逗号或空格分隔
FLUFFS_SUPERUSERS=
# 黑名单：机器人整体无视这些 QQ 号的消息，多个用逗号或空格分隔
FLUFFS_BLACKLIST=
FLUFFS_IGNORE_SELF=true

# ---- 日志（[log]）：DEBUG / INFO / WARNING / ERROR ----
FLUFFS_LOG_LEVEL=DEBUG

# ---- 大模型（[llm]）----
FLUFFS_LLM_ENABLED=true
FLUFFS_LLM_PROVIDER=openai_compat
FLUFFS_LLM_API_KEY=
FLUFFS_LLM_BASE_URL=
FLUFFS_LLM_MODEL=
FLUFFS_LLM_ALLOW_PRIVATE=false

# ---- 聊天记录（[chatlog]）----
FLUFFS_CHATLOG_ENABLED=true
# all | mention
FLUFFS_CHATLOG_SCOPE=all
FLUFFS_CHATLOG_DIR=data/chatlog
FLUFFS_CHATLOG_FLUSH_INTERVAL=60
FLUFFS_CHATLOG_MAX_BUFFER=200
