# .env.example 复制+改名 .env
# 优先级 env > config.toml
FLUFFS_TOKEN=

# 日志级别：DEBUG / INFO / WARNING / ERROR
FLUFFS_LOG_LEVEL=DEBUG
FLUFFS_LLM_ENABLED=true
FLUFFS_LLM_API_KEY=
FLUFFS_LLM_BASE_URL=
FLUFFS_LLM_MODEL=
FLUFFS_CHATLOG_ENABLED=true
# all | mention
FLUFFS_CHATLOG_SCOPE=all
FLUFFS_CHATLOG_DIR=data/chatlog
FLUFFS_CHATLOG_FLUSH_INTERVAL=60
FLUFFS_CHATLOG_MAX_BUFFER=200
